+func TestPersonSweepEmailOptInPreservesOwnSignatureAndSenderScope(t *testing.T) {
+	for _, sourceType := range []string{"gmail", "imap", " IMAP "} {
+		t.Run(sourceType, func(t *testing.T) {
+			t.Setenv("MSGVAULT_PEOPLE_EMAIL_EVIDENCE", "1")
+			f := newPersonSweepJournalFixture(t, true, false)
+			_, err := f.store.DB().ExecContext(t.Context(), f.store.Rebind(
+				`UPDATE sources SET source_type = ? WHERE id = ?`), sourceType, f.sourceID)
+			require.NoError(t, err)
+			id := f.insertMessage(t, "sender-own-mail", "email", f.aliceID, time.Now().UTC())
+			addSweepBody(t, f, id, "I work in product.\n\n-- \nAlice Example\nProduct Lead at Example Ltd\n\nOn Monday, Someone wrote:\n> I am the CEO.\n\n-- \nQuoted Signature")
+			owner := f.insertMessage(t, "recipient-only", "email", f.bobID, time.Now().UTC())
+			addSweepBody(t, f, owner, "I am a lawyer.")
+			_, err = f.store.DB().ExecContext(t.Context(), f.store.Rebind(
+				`INSERT INTO message_recipients (message_id, participant_id, recipient_type, email_address) VALUES (?, ?, 'to', ?)`), owner, f.aliceID, "alice@example.test")
+			require.NoError(t, err)
+			seeds := loadSweepWindow(t, f, peoplesweep.SourceConversationText, 0).Seeds
+			item := sweepItem(t, seeds, id)
+			require.NotNil(t, item.SubjectPersonID)
+			assert.Equal(t, f.alicePersonID, *item.SubjectPersonID)
+			assert.Equal(t, personfacts.DirectSelf, item.Directness)
+			assert.Contains(t, item.Excerpt, "Product Lead at Example Ltd")
+			assert.NotContains(t, item.Excerpt, "I am the CEO")
+			assert.NotContains(t, item.Excerpt, "Quoted Signature")
+			assert.Nil(t, sweepItem(t, seeds, owner).SubjectPersonID)
+			listed, err := f.store.ListPersonSweepHistoricalCandidates(t.Context(), peoplesweep.HistoricalCandidateRequest{
+				PersonID: f.alicePersonID, Limit: 20, AuthoredByPerson: true})
+			require.NoError(t, err)
+			assert.Contains(t, listed, id)
+			assert.NotContains(t, listed, owner)
+			aligned, err := (store.PersonSweepEvidenceAligner{Store: f.store}).Align(t.Context(), sweepEvidenceInput(t, item))
+			require.NoError(t, err)
+			assert.True(t, aligned.Accepted)
+			// Disabling the deployment opt-in invalidates the formerly admitted subject.
+			t.Setenv("MSGVAULT_PEOPLE_EMAIL_EVIDENCE", "0")
+			aligned, err = (store.PersonSweepEvidenceAligner{Store: f.store}).Align(t.Context(), sweepEvidenceInput(t, item))
+			require.NoError(t, err)
+			assert.False(t, aligned.Accepted)
+		})
+	}
+}
+
+func TestPersonSweepEmailOptInDoesNotTrustUnknownSources(t *testing.T) {
+	t.Setenv("MSGVAULT_PEOPLE_EMAIL_EVIDENCE", "1")
+	f := newPersonSweepJournalFixture(t, true, false)
+	_, err := f.store.DB().ExecContext(t.Context(), f.store.Rebind(
+		`UPDATE sources SET source_type = 'unknown-mail-import' WHERE id = ?`), f.sourceID)
+	require.NoError(t, err)
+	id := f.insertMessage(t, "unknown-mail", "email", f.aliceID, time.Now().UTC())
+	addSweepBody(t, f, id, "I work in product.")
+	item := sweepItem(t, loadSweepWindow(t, f, peoplesweep.SourceConversationText, 0).Seeds, id)
+	assert.Nil(t, item.SubjectPersonID)
+}
+
+func TestPersonSweepEmailOptInDropsLocalizedForwardedText(t *testing.T) {
+	for _, separator := range []string{
+		"Am Montag schrieb Andere Person:",
+		"El lunes, Otra Persona escribió:",
+		"Le lundi, Autre Personne a écrit :",
+		"Zitat von other@example.test:",
+		"-----Original Message-----",
+		"From: Other <other@example.test>\nSent: Monday",
+	} {
+		t.Run(separator, func(t *testing.T) {
+			t.Setenv("MSGVAULT_PEOPLE_EMAIL_EVIDENCE", "1")
+			f := newPersonSweepJournalFixture(t, true, false)
+			_, err := f.store.DB().ExecContext(t.Context(), f.store.Rebind(
+				`UPDATE sources SET source_type = 'imap' WHERE id = ?`), f.sourceID)
+			require.NoError(t, err)
+			id := f.insertMessage(t, "localized-reply", "email", f.aliceID, time.Now().UTC())
+			addSweepBody(t, f, id, "I work in product.\n-- \nProduct Lead at Example Ltd\n\n"+separator+"\nI am the CEO of Another Company.")
+			item := sweepItem(t, loadSweepWindow(t, f, peoplesweep.SourceConversationText, 0).Seeds, id)
+			assert.Contains(t, item.Excerpt, "Product Lead at Example Ltd")
+			assert.NotContains(t, item.Excerpt, "CEO")
+			assert.NotContains(t, item.Excerpt, "Another Company")
+		})
+	}
+}
+
+func TestPersonSweepEmailOptInDoesNotRestoreQuotedPreview(t *testing.T) {
+	t.Setenv("MSGVAULT_PEOPLE_EMAIL_EVIDENCE", "1")
+	f := newPersonSweepJournalFixture(t, true, false)
+	_, err := f.store.DB().ExecContext(t.Context(), f.store.Rebind(
+		`UPDATE sources SET source_type = 'imap' WHERE id = ?`), f.sourceID)
+	require.NoError(t, err)
+	id := f.insertMessage(t, "quoted-only-preview", "email", f.aliceID, time.Now().UTC())
+	addSweepBody(t, f, id, "On Monday, Someone wrote:\n> I am the CEO.")
+	_, err = f.store.DB().ExecContext(t.Context(), f.store.Rebind(
+		`UPDATE messages SET snippet = 'I am the CEO.' WHERE id = ?`), id)
+	require.NoError(t, err)
+	assert.NotContains(t, sweepMessageIDs(loadSweepWindow(t, f, peoplesweep.SourceConversationText, 0).Seeds), id)
+}
