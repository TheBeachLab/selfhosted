+// Email evidence is an explicit deployment opt-in. The archive's sender/profile
+// binding scopes self-reported email facts; it does not authenticate a From
+// header. Keep document authorship on the stricter platform-authenticated path.
+func personSweepEmailEvidenceEnabled(sourceType string) bool {
+	if os.Getenv("MSGVAULT_PEOPLE_EMAIL_EVIDENCE") != "1" {
+		return false
+	}
+	return slices.Contains([]string{"gmail", "imap"},
+		strings.ToLower(strings.Trim(sourceType, " ")))
+}
+
+func personSweepSourceAttributesMessageSender(sourceType string) bool {
+	return personSweepSourceAuthenticatesSender(sourceType) ||
+		personSweepEmailEvidenceEnabled(sourceType)
+}
+
+// Share the opt-in list with the SQL candidate filter so a brief's listing and
+// its evidence hydration admit exactly the same sender-bound messages.
+func personSweepAttributedMessageSenderSourceTypes() []string {
+	types := personSweepAuthenticatedSenderSourceTypes()
+	if personSweepEmailEvidenceEnabled("gmail") {
+		types = append(types, "gmail", "imap")
+	}
+	return types
+}
