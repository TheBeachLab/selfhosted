+package store
+
+import (
+	"regexp"
+	"strings"
+)
+
+// Stop at the first quoted/forwarded reply, including common localized client
+// separators. Inline comments after quoted text are deliberately omitted: the
+// extractor prefers less evidence over attributing another person's words.
+var personSweepEmailReplyStart = regexp.MustCompile(`(?mi)^[ \t]*(?:>+|On .{1,240} wrote:|Am .{1,240} schrieb .{0,120}:|El .{1,240} escribi[oó]:|Le .{1,240} a écrit[ \t]*:|Zitat von .{1,240}:|[-_]{5,}|-{2,}[ \t]*(?:Original Message|Ursprüngliche Nachricht|Mensaje original|Forwarded message|Weitergeleitete Nachricht)[ \t]*-{2,}|(?:From|Von|De):[^\n]*\n[ \t]*(?:Sent|Gesendet|Enviado|Date|Datum|Fecha):)`)
+
+func personSweepEmailOwnText(body string) string {
+	body = strings.ReplaceAll(body, "\r\n", "\n")
+	if location := personSweepEmailReplyStart.FindStringIndex(body); location != nil {
+		body = body[:location[0]]
+	}
+	return strings.TrimSpace(body)
+}
