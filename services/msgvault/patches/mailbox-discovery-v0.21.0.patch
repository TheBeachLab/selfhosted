+package mailboxdiscovery
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestMailboxSignatureRequiresFooterNameAndBoundsDisclosure(t *testing.T) {
+	assert.Empty(t, OwnSignature("I met Alice Example yesterday.\nThanks,\nBob Example", "Alice Example"))
+	sig := OwnSignature("Private project prose\n\n-- \nAlice Example\nMobil: 0123 456 7890\n"+strings.Repeat("x", 2000), "Alice Example")
+	assert.NotContains(t, sig, "Private project prose")
+	assert.Len(t, []rune(sig), MaxSignatureRunes)
+	assert.Equal(t, []string{"01234567890"}, MatchingPhones(sig, "*Alice Example & Bob Example*\n*Mobil 01234 567 890 & 0987 654 3210*"))
+	assert.Empty(t, OwnSignature("Alice Othername\nMobil: 0123 456 7890", "Alice Example"))
+}
+
+func TestMailboxProviderRequiresBothPinnedProbabilities(t *testing.T) {
+	for _, body := range []string{
+		`{"model":"jev-latest","answers":{"related":{"type":"noul","noul":1},"shared":{"type":"noul","noul":1}}}`,
+		`{"model":"jev-1.13.0","answers":{"related":{"type":"noul","noul":1}}}`,
+		`{"model":"jev-1.13.0","answers":{"related":{"type":"noul","noul":1},"shared":{"type":"noul","noul":2}}}`,
+		`{"model":"jev-1.13.0","answers":{"related":{"type":"noul","noul":1},"shared":{"type":"noul","noul":0.9}}}`,
+	} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			assert.Equal(t, "Bearer synthetic-fixture", r.Header.Get("Authorization"))
+			_, _ = w.Write([]byte(body))
+		}))
+		j, err := Score(t.Context(), Packet{}, "synthetic-fixture", func(_ context.Context, f func() error) (bool, error) { return true, f() }, server.URL)
+		if strings.Contains(body, `"noul":0.9`) {
+			require.NoError(t, err)
+			assert.Equal(t, 0.9, j.Shared)
+		} else {
+			require.Error(t, err)
+		}
+		server.Close()
+	}
+}
+
+func TestMailboxProviderConsentGateAndRedirectCannotLeakKey(t *testing.T) {
+	calls := 0
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		http.Redirect(w, r, "https://example.invalid/secret", http.StatusFound)
+	}))
+	defer server.Close()
+	_, err := Score(t.Context(), Packet{}, "synthetic-fixture", func(context.Context, func() error) (bool, error) { return false, nil }, server.URL)
+	require.Error(t, err)
+	assert.Zero(t, calls)
+	_, err = Score(t.Context(), Packet{}, "synthetic-fixture", func(_ context.Context, f func() error) (bool, error) { return true, f() }, server.URL)
+	require.ErrorContains(t, err, "HTTP 302")
+	assert.Equal(t, 1, calls)
+}
+
+func TestMailboxSignatureDropsDecoratedGMXReplyBeforeDisclosing(t *testing.T) {
+	text := "Alice Example\n\n*Alice Example & Bob Example*\n*Mobil 01234 567 890 & 0987 654 3210*\n\n*Gesendet:* Monday\n*Von:* owner@example.test\n*Betreff:* Private apartment\nPrivate quoted conversation"
+	sig := OwnSignature(text, "Alice Example")
+	assert.Contains(t, sig, "Bob Example")
+	assert.NotContains(t, sig, "Gesendet")
+	assert.NotContains(t, sig, "Private")
+	assert.Equal(t, []string{"01234567890"}, MatchingMobilePhones("Alice Example\nMobil: 0123 456 7890", sig))
+	assert.Empty(t, MatchingMobilePhones("Alice Example\nTel: 0123 456 7890", sig))
+}
+
+func TestMailboxPossibleSharedContactRequiresMobileAndKeepsUncertainty(t *testing.T) {
+	c := Candidate{Packet: Packet{MatchingPhones: []string{"01234567890"}, MatchingMobilePhones: []string{"01234567890"}}}
+	assert.True(t, Publishable(c, Judgment{Related: 0.68, Shared: 0.91}))
+	assert.False(t, Publishable(c, Judgment{Related: 0.49, Shared: 0.99}))
+	assert.False(t, Publishable(c, Judgment{Related: 0.68, Shared: 0.79}))
+	c.Packet.MatchingMobilePhones = nil
+	assert.False(t, Publishable(c, Judgment{Related: 0.68, Shared: 0.91}))
+	assert.True(t, Publishable(c, Judgment{Related: 0.96, Shared: 0.10}))
+}
