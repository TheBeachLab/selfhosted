+// The serving daemon uses this adapter rather than exposing *store.Store to
+// API handlers. Keep every discovery capability forwarded through this owner.
+func (a *storeAPIAdapter) DiscoverMailboxCandidatesContext(ctx context.Context, limit int) (store.MailboxDiscoveryPage, error) {
+	return a.store.DiscoverMailboxCandidatesContext(ctx, limit)
+}
+func (a *storeAPIAdapter) AdvanceMailboxDiscoveryCursorContext(ctx context.Context, cursor int64) error {
+	return a.store.AdvanceMailboxDiscoveryCursorContext(ctx, cursor)
+}
+func (a *storeAPIAdapter) ClaimMailboxDiscoveryContext(ctx context.Context, c mailboxdiscovery.Candidate, disclosure string) (string, string, error) {
+	return a.store.ClaimMailboxDiscoveryContext(ctx, c, disclosure)
+}
+func (a *storeAPIAdapter) FinishMailboxDiscoveryContext(ctx context.Context, c mailboxdiscovery.Candidate, fp, token string, j *mailboxdiscovery.Judgment) (*store.MailboxDiscoveryResult, error) {
+	return a.store.FinishMailboxDiscoveryContext(ctx, c, fp, token, j)
+}
+func (a *storeAPIAdapter) ListMailboxDiscoveryHistoryContext(ctx context.Context) ([]store.MailboxDiscoveryResult, error) {
+	return a.store.ListMailboxDiscoveryHistoryContext(ctx)
+}
