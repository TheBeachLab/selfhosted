+package api
+
+import (
+	"context"
+	"net/http"
+	"os"
+	"strings"
+
+	"github.com/danielgtaylor/huma/v2"
+	"go.kenn.io/msgvault/internal/mailboxdiscovery"
+	"go.kenn.io/msgvault/internal/personmatch"
+	"go.kenn.io/msgvault/internal/store"
+)
+
+type mailboxDiscoveryStore interface {
+	personMatchConsentStore
+	DiscoverMailboxCandidatesContext(context.Context, int) (store.MailboxDiscoveryPage, error)
+	AdvanceMailboxDiscoveryCursorContext(context.Context, int64) error
+	ClaimMailboxDiscoveryContext(context.Context, mailboxdiscovery.Candidate, string) (string, string, error)
+	FinishMailboxDiscoveryContext(context.Context, mailboxdiscovery.Candidate, string, string, *mailboxdiscovery.Judgment) (*store.MailboxDiscoveryResult, error)
+	PersonMatchConsentEgressContext(context.Context, string, func() error) (bool, error)
+	ListMailboxDiscoveryHistoryContext(context.Context) ([]store.MailboxDiscoveryResult, error)
+}
+
+type MailboxDiscoveryStatus struct {
+	Enabled                bool                    `json:"enabled"`
+	Ready                  bool                    `json:"ready"`
+	CredentialAvailable    bool                    `json:"credential_available"`
+	ConsentActive          bool                    `json:"consent_active"`
+	Disclosure             *personmatch.Disclosure `json:"disclosure,omitempty"`
+	DisclosureFingerprint  string                  `json:"disclosure_fingerprint,omitempty"`
+	DataFields             string                  `json:"data_fields"`
+	DailyRequestLimit      int                     `json:"daily_request_limit"`
+	MinimumPossibleRelated float64                 `json:"minimum_possible_shared_relation"`
+	MinimumShared          float64                 `json:"minimum_shared_probability"`
+	MinimumRelated         float64                 `json:"minimum_related_probability"`
+	Blocker                string                  `json:"blocker,omitempty"`
+}
+
+type MailboxDiscoveryRunRequest struct {
+	Limit int `json:"limit"`
+}
+type MailboxDiscoveryRunResponse struct {
+	Scanned          int                            `json:"scanned_messages"`
+	Candidates       int                            `json:"candidates"`
+	ProviderRequests int                            `json:"provider_requests"`
+	Results          []store.MailboxDiscoveryResult `json:"results"`
+	NextCursor       int64                          `json:"next_cursor"`
+	Error            string                         `json:"error,omitempty"`
+}
+
+func (s *Server) registerMailboxDiscoveryRoutes(api huma.API) {
+	for _, action := range []string{"status", "history", "consent", "revoke", "run"} {
+		method := http.MethodGet
+		if action == "consent" || action == "revoke" || action == "run" {
+			method = http.MethodPost
+		}
+		op := rawAPIV1Operation("mailboxDiscovery"+strings.ToUpper(action[:1])+action[1:], method, "/identity/discovery/"+action, "Native related email mailbox discovery: "+action)
+		switch action {
+		case "status":
+			op.Responses = jsonResponsesFor[MailboxDiscoveryStatus](api)
+		case "history":
+			op.Responses = jsonResponsesFor[[]store.MailboxDiscoveryResult](api)
+		case "run":
+			op.RequestBody = jsonRequestBodyFor[MailboxDiscoveryRunRequest](api)
+			op.Responses = jsonResponsesFor[MailboxDiscoveryRunResponse](api)
+		default:
+			op.RequestBody = jsonRequestBodyFor[PersonMatchConsentDecisionRequest](api)
+			op.Responses = jsonResponsesFor[PersonMatchConsentDecisionResponse](api)
+		}
+		addErrorResponses(api, op.Responses, http.StatusConflict, http.StatusServiceUnavailable)
+		registerRawHumaRoute(api, op, s.handleMailboxDiscovery)
+	}
+}
+
+func (s *Server) mailboxDiscoveryStatus(ctx context.Context, st mailboxDiscoveryStore) (MailboxDiscoveryStatus, error) {
+	status := MailboxDiscoveryStatus{DataFields: mailboxdiscovery.DataFields, DailyRequestLimit: mailboxdiscovery.DailyRequestLimit, MinimumRelated: mailboxdiscovery.MinimumRelated, MinimumPossibleRelated: mailboxdiscovery.MinimumPossibleRelated, MinimumShared: mailboxdiscovery.MinimumShared}
+	if s.cfg == nil || os.Getenv("MSGVAULT_PEOPLE_EMAIL_DISCOVERY") != "1" {
+		status.Blocker = "discovery_disabled"
+		return status, nil
+	}
+	status.Enabled = true
+	d, err := mailboxdiscovery.Disclosure(s.cfg.People.IdentityScoring)
+	if err != nil {
+		status.Blocker = "invalid_jev_config"
+		return status, nil
+	}
+	status.Disclosure = &d
+	status.DisclosureFingerprint, err = d.Fingerprint()
+	if err != nil {
+		return status, err
+	}
+	_, err = s.cfg.People.IdentityScoring.CredentialFromEnvironment()
+	status.CredentialAvailable = err == nil
+	status.ConsentActive, err = st.HasPersonMatchConsentContext(ctx, status.DisclosureFingerprint)
+	if err != nil {
+		return status, err
+	}
+	switch {
+	case !status.CredentialAvailable:
+		status.Blocker = "credential_unavailable"
+	case !status.ConsentActive:
+		status.Blocker = "consent_required"
+	default:
+		status.Ready = true
+	}
+	return status, nil
+}
+
+func (s *Server) handleMailboxDiscovery(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Cache-Control", "no-store")
+	st, ok := s.store.(mailboxDiscoveryStore)
+	if !ok {
+		writeError(w, http.StatusServiceUnavailable, "feature_unavailable", "Native mailbox discovery is unavailable")
+		return
+	}
+	action := strings.TrimPrefix(r.URL.Path, "/api/v1/identity/discovery/")
+	status, err := s.mailboxDiscoveryStatus(r.Context(), st)
+	if err != nil {
+		writeError(w, http.StatusServiceUnavailable, "discovery_unavailable", "Discovery status is unavailable")
+		return
+	}
+	switch action {
+	case "status":
+		writeJSON(w, http.StatusOK, status)
+	case "history":
+		history, err := st.ListMailboxDiscoveryHistoryContext(r.Context())
+		if err != nil {
+			writeError(w, http.StatusServiceUnavailable, "history_unavailable", "Discovery history unavailable")
+			return
+		}
+		writeJSON(w, http.StatusOK, history)
+	case "consent", "revoke":
+		var body PersonMatchConsentDecisionRequest
+		if !decodeIdentityMatchJSON(w, r, &body) {
+			return
+		}
+		var changed bool
+		if action == "consent" {
+			if status.Disclosure == nil || body.DisclosureFingerprint != status.DisclosureFingerprint {
+				writeError(w, http.StatusConflict, "disclosure_changed", "Read current discovery disclosure before granting consent")
+				return
+			}
+			_, changed, err = st.GrantPersonMatchConsentContext(r.Context(), *status.Disclosure, apiPersonMatchConsentActor, s.beginIdentityScoringMutation)
+		} else {
+			changed, err = st.RevokePersonMatchConsentContext(r.Context(), body.DisclosureFingerprint, apiPersonMatchConsentActor, s.beginIdentityScoringMutation)
+		}
+		if err != nil {
+			writeError(w, http.StatusServiceUnavailable, "consent_unavailable", "Discovery consent unavailable")
+			return
+		}
+		writeJSON(w, http.StatusOK, PersonMatchConsentDecisionResponse{DisclosureFingerprint: body.DisclosureFingerprint, ConsentActive: action == "consent", Changed: changed})
+	case "run":
+		if !status.Ready {
+			writeError(w, http.StatusConflict, status.Blocker, "Mailbox discovery is not ready")
+			return
+		}
+		var body MailboxDiscoveryRunRequest
+		if !decodeIdentityMatchJSON(w, r, &body) {
+			return
+		}
+		if body.Limit == 0 {
+			body.Limit = 8
+		}
+		if body.Limit < 1 || body.Limit > 20 {
+			writeError(w, http.StatusBadRequest, "invalid_limit", "Provider request limit must be 1-20")
+			return
+		}
+		if !s.mailboxDiscoveryRunning.CompareAndSwap(false, true) {
+			writeError(w, http.StatusConflict, "discovery_running", "Discovery is already running")
+			return
+		}
+		defer s.mailboxDiscoveryRunning.Store(false)
+		response := s.runMailboxDiscovery(r.Context(), st, status, body.Limit)
+		writeJSON(w, http.StatusOK, response)
+	}
+}
+
+func (s *Server) runMailboxDiscovery(ctx context.Context, st mailboxDiscoveryStore, status MailboxDiscoveryStatus, limit int) MailboxDiscoveryRunResponse {
+	result := MailboxDiscoveryRunResponse{Results: []store.MailboxDiscoveryResult{}}
+	page, err := st.DiscoverMailboxCandidatesContext(ctx, 5000)
+	if err != nil {
+		result.Error = "discovery_scan_failed"
+		return result
+	}
+	result.Scanned = page.Scanned
+	result.Candidates = len(page.Candidates)
+	result.NextCursor = page.NextCursor
+	key, err := s.cfg.People.IdentityScoring.CredentialFromEnvironment()
+	if err != nil {
+		result.Error = "credential_unavailable"
+		return result
+	}
+	for _, candidate := range page.Candidates {
+		if result.ProviderRequests >= limit {
+			return result
+		}
+		active, err := st.HasPersonMatchConsentContext(ctx, status.DisclosureFingerprint)
+		if err != nil || !active {
+			result.Error = "consent_required"
+			return result
+		}
+		done, err := s.beginIdentityScoringMutation(ctx)
+		if err != nil {
+			result.Error = "archive_busy"
+			return result
+		}
+		fp, token, err := st.ClaimMailboxDiscoveryContext(ctx, candidate, status.DisclosureFingerprint)
+		done()
+		if err != nil {
+			result.Error = "discovery_claim_failed"
+			return result
+		}
+		if token == "" {
+			continue
+		}
+		result.ProviderRequests++
+		judgment, scoreErr := mailboxdiscovery.Score(ctx, candidate.Packet, key, func(ctx context.Context, dispatch func() error) (bool, error) {
+			return st.PersonMatchConsentEgressContext(ctx, status.DisclosureFingerprint, dispatch)
+		}, s.mailboxDiscoveryEndpoint)
+		var scored *mailboxdiscovery.Judgment
+		if scoreErr == nil {
+			scored = &judgment
+		}
+		done, err = s.beginIdentityScoringMutation(ctx)
+		if err != nil {
+			result.Error = "archive_busy"
+			return result
+		}
+		completed, err := st.FinishMailboxDiscoveryContext(ctx, candidate, fp, token, scored)
+		done()
+		if err != nil {
+			result.Error = "discovery_publish_failed"
+			return result
+		}
+		result.Results = append(result.Results, *completed)
+		if scoreErr != nil {
+			result.Error = "provider_request_failed"
+			return result
+		}
+	}
+	done, err := s.beginIdentityScoringMutation(ctx)
+	if err != nil {
+		result.Error = "archive_busy"
+		return result
+	}
+	err = st.AdvanceMailboxDiscoveryCursorContext(ctx, page.NextCursor)
+	done()
+	if err != nil {
+		result.Error = "discovery_cursor_failed"
+	}
+	return result
+}
