+package store
+
+import (
+	"context"
+	"database/sql"
+	"encoding/json/v2"
+	"errors"
+	"fmt"
+	"math"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"go.kenn.io/msgvault/internal/mailboxdiscovery"
+)
+
+type MailboxDiscoveryPage struct {
+	Candidates []mailboxdiscovery.Candidate
+	Scanned    int
+	NextCursor int64
+}
+
+type MailboxDiscoveryResult struct {
+	Fingerprint    string                     `json:"fingerprint"`
+	PersonID       int64                      `json:"person_id"`
+	SenderID       int64                      `json:"sender_id"`
+	Email          string                     `json:"email"`
+	MessageID      int64                      `json:"message_id"`
+	KnownMessageID int64                      `json:"known_message_id"`
+	Status         string                     `json:"status"`
+	Judgment       *mailboxdiscovery.Judgment `json:"judgment,omitempty"`
+	ContactPointID *int64                     `json:"contact_point_id,omitempty"`
+	Model          string                     `json:"model"`
+	AttemptedAt    int64                      `json:"attempted_at"`
+}
+
+type mailboxMessage struct {
+	id, sender int64
+	email      string
+}
+
+// Metadata selection never joins/scans message_bodies. Hydration below is by
+// primary key, with a byte ceiling. Scan pages rotate through the whole archive.
+func (s *Store) mailboxMessages(ctx context.Context, sender, after int64, limit int) ([]mailboxMessage, error) {
+	query := `SELECT m.id, m.sender_id, p.email_address FROM messages m
+		JOIN participants p ON p.id = m.sender_id
+		WHERE m.id > ? AND m.deleted_at IS NULL AND m.deleted_from_source_at IS NULL
+		AND (m.is_from_me = FALSE OR m.is_from_me IS NULL)
+		AND (m.is_forwarded = FALSE OR m.is_forwarded IS NULL)
+		AND p.email_address IS NOT NULL AND LENGTH(p.email_address) <= 256
+		AND EXISTS (SELECT 1 FROM sources s WHERE s.id = m.source_id AND s.source_type IN ('gmail','imap'))`
+	args := []any{after}
+	if sender > 0 {
+		query += ` AND m.sender_id = ?`
+		args = append(args, sender)
+	}
+	query += ` ORDER BY m.id`
+	if sender > 0 {
+		query += ` DESC`
+	}
+	query += ` LIMIT ?`
+	args = append(args, limit)
+	rows, err := s.db.QueryContext(ctx, s.Rebind(query), args...)
+	if err != nil {
+		return nil, fmt.Errorf("mailbox metadata: %w", err)
+	}
+	defer func() { _ = rows.Close() }()
+	items := []mailboxMessage{}
+	for rows.Next() {
+		var m mailboxMessage
+		if err := rows.Scan(&m.id, &m.sender, &m.email); err != nil {
+			return nil, err
+		}
+		items = append(items, m)
+	}
+	return items, rows.Err()
+}
+
+func (s *Store) mailboxOwnSignature(ctx context.Context, m mailboxMessage, name string) (mailboxdiscovery.Signature, error) {
+	var body sql.NullString
+	err := s.db.QueryRowContext(ctx, s.Rebind(`SELECT SUBSTR(body_text,1,32768) FROM message_bodies WHERE message_id = ?`), m.id).Scan(&body)
+	if errors.Is(err, sql.ErrNoRows) {
+		return mailboxdiscovery.Signature{}, nil
+	}
+	if err != nil {
+		return mailboxdiscovery.Signature{}, err
+	}
+	return mailboxdiscovery.Signature{MessageID: m.id, SenderID: m.sender, Email: strings.ToLower(strings.TrimSpace(m.email)), Text: mailboxdiscovery.OwnSignature(personSweepEmailOwnText(body.String), name)}, nil
+}
+
+func (s *Store) DiscoverMailboxCandidatesContext(ctx context.Context, limit int) (MailboxDiscoveryPage, error) {
+	if limit < 1 || limit > 5000 {
+		return MailboxDiscoveryPage{}, errors.New("mailbox scan limit must be 1-5000")
+	}
+	var cursor int64
+	if err := s.db.QueryRowContext(ctx, `SELECT after_message_id FROM mailbox_discovery_state WHERE singleton=1`).Scan(&cursor); err != nil {
+		return MailboxDiscoveryPage{}, err
+	}
+	ids, err := s.ListTrackedPeopleContext(ctx, 0, 1000)
+	if err != nil {
+		return MailboxDiscoveryPage{}, err
+	}
+	anchors := []mailboxdiscovery.Candidate{}
+	for _, id := range ids {
+		person, err := s.GetPersonContext(ctx, id)
+		if err != nil {
+			return MailboxDiscoveryPage{}, err
+		}
+		if person.DisplayName == nil {
+			continue
+		}
+		var best mailboxdiscovery.Signature
+		for _, sender := range person.ParticipantIDs {
+			messages, err := s.mailboxMessages(ctx, sender, 0, 16)
+			if err != nil {
+				return MailboxDiscoveryPage{}, err
+			}
+			for _, m := range messages {
+				sig, err := s.mailboxOwnSignature(ctx, m, *person.DisplayName)
+				if err != nil {
+					return MailboxDiscoveryPage{}, err
+				}
+				if len(mailboxdiscovery.Phones(sig.Text)) > len(mailboxdiscovery.Phones(best.Text)) {
+					best = sig
+				}
+			}
+		}
+		if best.Text != "" {
+			anchors = append(anchors, mailboxdiscovery.Candidate{PersonID: id, Revision: person.Revision, Packet: mailboxdiscovery.Packet{Schema: mailboxdiscovery.Schema, Name: *person.DisplayName, Known: best}})
+		}
+	}
+	items, err := s.mailboxMessages(ctx, 0, cursor, limit)
+	if err != nil {
+		return MailboxDiscoveryPage{}, err
+	}
+	page := MailboxDiscoveryPage{Scanned: len(items), Candidates: []mailboxdiscovery.Candidate{}}
+	if len(items) == limit {
+		page.NextCursor = items[len(items)-1].id
+	}
+	// Known author identities must not be rebound by mailbox discovery.
+	bound := map[int64]bool{}
+	rows, err := s.db.QueryContext(ctx, `SELECT participant_id FROM person_participants`)
+	if err != nil {
+		return page, err
+	}
+	for rows.Next() {
+		var id int64
+		if err := rows.Scan(&id); err != nil {
+			_ = rows.Close()
+			return page, err
+		}
+		bound[id] = true
+	}
+	err = rows.Err()
+	_ = rows.Close()
+	if err != nil {
+		return page, err
+	}
+	seen := map[string]bool{}
+	for _, m := range items {
+		if bound[m.sender] {
+			continue
+		}
+		var body sql.NullString
+		err := s.db.QueryRowContext(ctx, s.Rebind(`SELECT SUBSTR(body_text,1,32768) FROM message_bodies WHERE message_id=?`), m.id).Scan(&body)
+		if errors.Is(err, sql.ErrNoRows) {
+			continue
+		}
+		if err != nil {
+			return page, err
+		}
+		own := personSweepEmailOwnText(body.String)
+		for _, anchor := range anchors {
+			pair := fmt.Sprintf("%d:%d", anchor.PersonID, m.sender)
+			if seen[pair] {
+				continue
+			}
+			sig := mailboxdiscovery.Signature{MessageID: m.id, SenderID: m.sender, Email: strings.ToLower(strings.TrimSpace(m.email)), Text: mailboxdiscovery.OwnSignature(own, anchor.Packet.Name)}
+			phones := mailboxdiscovery.MatchingPhones(anchor.Packet.Known.Text, sig.Text)
+			if sig.Text == "" || len(phones) == 0 {
+				continue
+			}
+			candidate := anchor
+			candidate.Packet.Candidate = sig
+			candidate.Packet.MatchingPhones = phones
+			candidate.Packet.MatchingMobilePhones = mailboxdiscovery.MatchingMobilePhones(anchor.Packet.Known.Text, sig.Text)
+			page.Candidates = append(page.Candidates, candidate)
+			seen[pair] = true
+		}
+	}
+	return page, nil
+}
+
+func (s *Store) AdvanceMailboxDiscoveryCursorContext(ctx context.Context, cursor int64) error {
+	_, err := s.db.ExecContext(ctx, s.Rebind(`UPDATE mailbox_discovery_state SET after_message_id=? WHERE singleton=1`), cursor)
+	return err
+}
+
+// Claim is durable across daemon restarts. A global daily ceiling counts attempted
+// provider requests, including errors. The token fences late/stale completions.
+func (s *Store) ClaimMailboxDiscoveryContext(ctx context.Context, c mailboxdiscovery.Candidate, disclosure string) (string, string, error) {
+	fingerprint, err := mailboxdiscovery.Fingerprint(c, disclosure)
+	if err != nil {
+		return "", "", err
+	}
+	packet, err := json.Marshal(c.Packet)
+	if err != nil {
+		return "", "", err
+	}
+	token := ""
+	err = s.withTxContext(ctx, func(tx *loggedTx) error {
+		if err := s.lockIdentityMutationTxContext(ctx, tx); err != nil {
+			return err
+		}
+		now := time.Now().UTC().Unix()
+		var due int64
+		err := tx.QueryRowContext(ctx, `SELECT retry_after FROM mailbox_discovery_judgments WHERE fingerprint=?`, fingerprint).Scan(&due)
+		if err != nil && !errors.Is(err, sql.ErrNoRows) {
+			return err
+		}
+		if err == nil && (due == 0 || due > now) {
+			return nil
+		}
+		var attempts int
+		day := time.Now().UTC().Format("2006-01-02")
+		if err := tx.QueryRowContext(ctx, `SELECT COALESCE(SUM(attempts),0) FROM mailbox_discovery_budget WHERE day=?`, day).Scan(&attempts); err != nil {
+			return err
+		}
+		if attempts >= mailboxdiscovery.DailyRequestLimit {
+			return nil
+		}
+		token = uuid.NewString()
+		_, err = tx.ExecContext(ctx, `INSERT INTO mailbox_discovery_budget(day,attempts) VALUES(?,1)
+			ON CONFLICT(day) DO UPDATE SET attempts=mailbox_discovery_budget.attempts+1`, day)
+		if err != nil {
+			return err
+		}
+		_, err = tx.ExecContext(ctx, `INSERT INTO mailbox_discovery_judgments
+			(fingerprint,person_id,sender_id,email,message_id,known_message_id,packet,disclosure,model,status,token,attempted_at,retry_after)
+			VALUES(?,?,?,?,?,?,?,?,?,'pending',?,?,?)
+			ON CONFLICT(fingerprint) DO UPDATE SET status='pending',token=excluded.token,attempted_at=excluded.attempted_at,retry_after=excluded.retry_after`,
+			fingerprint, c.PersonID, c.Packet.Candidate.SenderID, c.Packet.Candidate.Email, c.Packet.Candidate.MessageID, c.Packet.Known.MessageID, string(packet), disclosure, "jev-1.13.0", token, now, now+300)
+		return err
+	})
+	return fingerprint, token, err
+}
+
+// Publish contact point + journal together, without linking participants. User
+// values, prior supersessions, and untracked/changed profiles take precedence.
+func (s *Store) FinishMailboxDiscoveryContext(ctx context.Context, c mailboxdiscovery.Candidate, fingerprint, token string, j *mailboxdiscovery.Judgment) (*MailboxDiscoveryResult, error) {
+	if j != nil && (math.IsNaN(j.Related) || math.IsNaN(j.Shared) || j.Related < 0 || j.Related > 1 || j.Shared < 0 || j.Shared > 1) {
+		return nil, errors.New("invalid mailbox probability")
+	}
+	r := &MailboxDiscoveryResult{Fingerprint: fingerprint, PersonID: c.PersonID, SenderID: c.Packet.Candidate.SenderID, Email: c.Packet.Candidate.Email, MessageID: c.Packet.Candidate.MessageID, KnownMessageID: c.Packet.Known.MessageID, Model: "jev-1.13.0", Judgment: j, Status: "provider_error"}
+	err := s.withTxContext(ctx, func(tx *loggedTx) error {
+		if err := s.lockIdentityMutationTxContext(ctx, tx); err != nil {
+			return err
+		}
+		var current, disclosure string
+		if err := tx.QueryRowContext(ctx, `SELECT token,disclosure,attempted_at FROM mailbox_discovery_judgments WHERE fingerprint=? AND status='pending'`, fingerprint).Scan(&current, &disclosure, &r.AttemptedAt); err != nil {
+			return err
+		}
+		if current != token {
+			return errors.New("mailbox discovery lease changed")
+		}
+		retry := time.Now().UTC().Unix() + 86400
+		if j != nil {
+			retry = 0
+			r.Status = "review"
+			person, err := s.getPersonTx(ctx, tx, c.PersonID)
+			if err != nil {
+				return err
+			}
+			var tracked bool
+			if err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM person_tracking WHERE person_id=?)`, c.PersonID).Scan(&tracked); err != nil {
+				return err
+			}
+			var bound bool
+			if err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM person_participants WHERE participant_id=?)`, c.Packet.Candidate.SenderID).Scan(&bound); err != nil {
+				return err
+			}
+			// Rehydrate both evidence messages under the mutation transaction. A
+			// concurrent source edit/deletion cannot publish an outdated finding.
+			var consent bool
+			if err := tx.QueryRowContext(ctx, `SELECT EXISTS(SELECT 1 FROM person_match_consents WHERE disclosure_fingerprint=? AND revoked_at IS NULL)`, disclosure).Scan(&consent); err != nil {
+				return err
+			}
+			valid := consent
+			for _, sig := range []mailboxdiscovery.Signature{c.Packet.Known, c.Packet.Candidate} {
+				var body sql.NullString
+				var sender int64
+				var email string
+				err := tx.QueryRowContext(ctx, `SELECT m.sender_id,p.email_address FROM messages m JOIN participants p ON p.id=m.sender_id
+					WHERE m.id=? AND m.deleted_at IS NULL AND m.deleted_from_source_at IS NULL AND COALESCE(m.is_from_me,FALSE)=FALSE AND COALESCE(m.is_forwarded,FALSE)=FALSE`, sig.MessageID).Scan(&sender, &email)
+				if errors.Is(err, sql.ErrNoRows) {
+					valid = false
+					break
+				}
+				if err != nil {
+					return err
+				}
+				if err := tx.QueryRowContext(ctx, `SELECT SUBSTR(body_text,1,32768) FROM message_bodies WHERE message_id=?`, sig.MessageID).Scan(&body); err != nil {
+					return err
+				}
+				if sender != sig.SenderID || strings.ToLower(strings.TrimSpace(email)) != sig.Email || mailboxdiscovery.OwnSignature(personSweepEmailOwnText(body.String), c.Packet.Name) != sig.Text {
+					valid = false
+				}
+			}
+			if !tracked || bound || person.Revision != c.Revision || !valid {
+				r.Status = "stale"
+				retry = time.Now().UTC().Unix() + 900
+			} else if mailboxdiscovery.Publishable(c, *j) && len(c.Packet.MatchingPhones) > 0 {
+				var existing int
+				if err := tx.QueryRowContext(ctx, `SELECT COUNT(*) FROM person_contact_points WHERE person_id=? AND address_kind='email' AND normalized_value=?`, c.PersonID, c.Packet.Candidate.Email).Scan(&existing); err != nil {
+					return err
+				}
+				if existing > 0 {
+					r.Status = "already_recorded"
+				} else {
+					label := "otra dirección detectada"
+					r.Status = "related"
+					if j.Shared >= 0.5 {
+						label = "posiblemente compartido"
+						r.Status = "shared"
+					}
+					ref := "mailbox-discovery:" + fingerprint
+					point, err := s.addPersonContactPointTx(ctx, tx, c.PersonID, PersonContactPointInput{AddressKind: ContactAddressEmail, OriginalValue: c.Packet.Candidate.Email, Envelope: ValueEnvelopeInput{Source: ProvenanceExtraction, TypeLabel: &label, Confidence: &j.Related, SourceRef: &ref}})
+					if err != nil {
+						return err
+					}
+					r.ContactPointID = &point.Envelope.ID
+					if err := s.bumpPersonRevisionsTx(ctx, tx, c.PersonID); err != nil {
+						return err
+					}
+					if err := s.invalidatePersonEnrichmentIdentitiesAfterRevisionTx(ctx, tx, c.PersonID); err != nil {
+						return err
+					}
+				}
+			}
+		}
+		var related, shared any
+		if j != nil {
+			related, shared = j.Related, j.Shared
+		}
+		_, err := tx.ExecContext(ctx, `UPDATE mailbox_discovery_judgments SET status=?,related_probability=?,shared_probability=?,contact_point_id=?,retry_after=? WHERE fingerprint=? AND token=?`, r.Status, related, shared, r.ContactPointID, retry, fingerprint, token)
+		return err
+	})
+	return r, err
+}
+
+func (s *Store) ListMailboxDiscoveryHistoryContext(ctx context.Context) ([]MailboxDiscoveryResult, error) {
+	rows, err := s.db.QueryContext(ctx, `SELECT fingerprint,person_id,sender_id,email,message_id,known_message_id,status,related_probability,shared_probability,contact_point_id,model,attempted_at FROM mailbox_discovery_judgments ORDER BY attempted_at DESC,fingerprint LIMIT 100`)
+	if err != nil {
+		return nil, err
+	}
+	defer func() { _ = rows.Close() }()
+	results := []MailboxDiscoveryResult{}
+	for rows.Next() {
+		var r MailboxDiscoveryResult
+		var a, b sql.NullFloat64
+		var point sql.NullInt64
+		if err := rows.Scan(&r.Fingerprint, &r.PersonID, &r.SenderID, &r.Email, &r.MessageID, &r.KnownMessageID, &r.Status, &a, &b, &point, &r.Model, &r.AttemptedAt); err != nil {
+			return nil, err
+		}
+		if a.Valid && b.Valid {
+			r.Judgment = &mailboxdiscovery.Judgment{Related: a.Float64, Shared: b.Float64}
+		}
+		if point.Valid {
+			r.ContactPointID = &point.Int64
+		}
+		results = append(results, r)
+	}
+	return results, rows.Err()
+}
