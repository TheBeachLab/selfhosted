+func mailboxConsent(t *testing.T, st *store.Store) string {
+	t.Helper()
+	cfg := personmatch.Config{Enabled: true, ModelID: personmatch.ModelID, MinimumProbability: 0.8, CredentialEnv: "TEST_JEV_KEY", BatchSize: 20, RetentionDeclaration: "synthetic fixture"}
+	d, err := mailboxdiscovery.Disclosure(cfg)
+	require.NoError(t, err)
+	_, _, err = st.GrantPersonMatchConsentContext(t.Context(), d, "fixture_operator", nil)
+	require.NoError(t, err)
+	fp, err := d.Fingerprint()
+	require.NoError(t, err)
+	return fp
+}
