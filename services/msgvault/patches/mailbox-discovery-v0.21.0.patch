+package api
+
+import (
+	"database/sql"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.kenn.io/msgvault/internal/config"
+	"go.kenn.io/msgvault/internal/mailboxdiscovery"
+	"go.kenn.io/msgvault/internal/store"
+	"go.kenn.io/msgvault/internal/testutil"
+)
+
+func TestMailboxNativeDaemonConsentDiscoverySharedContactAndIdempotency(t *testing.T) {
+	t.Setenv("MSGVAULT_PEOPLE_EMAIL_DISCOVERY", "1")
+	st := testutil.NewTestStore(t)
+	source, err := st.GetOrCreateSource("imap", "archive@example.test")
+	require.NoError(t, err)
+	conv, err := st.EnsureConversationWithType(source.ID, "fixture-mail", "email", "Synthetic mail")
+	require.NoError(t, err)
+	known, err := st.EnsureParticipant("alice@work.example.test", "Alice Example", "work.example.test")
+	require.NoError(t, err)
+	unknown, err := st.EnsureParticipant("household@example.test", "household@example.test", "example.test")
+	require.NoError(t, err)
+	person, _, err := st.CreatePersonFromParticipant(known)
+	require.NoError(t, err)
+	_, err = st.SetPersonTrackingContext(t.Context(), person.ID, true)
+	require.NoError(t, err)
+	for i, item := range []struct {
+		sender int64
+		body   string
+	}{{known, "Private project\n-- \nAlice Example\nMobil: 0123 456 7890"}, {unknown, "Private household\nRegards,\n*Alice Example & Bob Example*\n*Mobil 01234 567 890 & 0987 654 3210*"}} {
+		id, err := st.UpsertMessage(&store.Message{SourceID: source.ID, SourceMessageID: []string{"known", "candidate"}[i], ConversationID: conv, MessageType: "email", SenderID: sql.NullInt64{Int64: item.sender, Valid: true}})
+		require.NoError(t, err)
+		_, err = st.DB().Exec(`INSERT INTO message_bodies(message_id,body_text) VALUES(?,?)`, id, item.body)
+		require.NoError(t, err)
+	}
+	var calls atomic.Int32
+	gate := NewSerialOperationGate()
+	provider := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		_, _, held := gate.Holder()
+		assert.False(t, held, "provider I/O must release backup operation gate")
+		var request map[string]any
+		require.NoError(t, json.NewDecoder(r.Body).Decode(&request))
+		encoded, err := json.Marshal(request)
+		require.NoError(t, err)
+		assert.NotContains(t, string(encoded), "Private project")
+		assert.NotContains(t, string(encoded), "Private household")
+		_, _ = w.Write([]byte(`{"model":"jev-1.13.0","answers":{"related":{"type":"noul","noul":0.99},"shared":{"type":"noul","noul":0.96}}}`))
+	}))
+	defer provider.Close()
+	cfg := config.NewDefaultConfig()
+	cfg.People.IdentityScoring.Enabled = true
+	cfg.People.IdentityScoring.CredentialEnv = "MSGVAULT_JEV_NATIVE_FIXTURE"
+	cfg.People.IdentityScoring.RetentionDeclaration = "synthetic fixture retention"
+	t.Setenv(cfg.People.IdentityScoring.CredentialEnv, "synthetic-fixture")
+	srv := NewServerWithOptions(ServerOptions{Config: cfg, Store: st, OperationGate: gate, Logger: testLogger()})
+	srv.mailboxDiscoveryEndpoint = provider.URL
+	run := personRequest(t, srv, http.MethodPost, "/api/v1/identity/discovery/run", []byte(`{"limit":8}`), "")
+	assert.Equal(t, http.StatusConflict, run.Code)
+	assert.Zero(t, calls.Load())
+	d, err := mailboxdiscovery.Disclosure(cfg.People.IdentityScoring)
+	require.NoError(t, err)
+	fp, err := d.Fingerprint()
+	require.NoError(t, err)
+	consent := personRequest(t, srv, http.MethodPost, "/api/v1/identity/discovery/consent", []byte(`{"disclosure_fingerprint":"`+fp+`"}`), "")
+	require.Equal(t, http.StatusOK, consent.Code, consent.Body.String())
+	for pass := range 2 {
+		run = personRequest(t, srv, http.MethodPost, "/api/v1/identity/discovery/run", []byte(`{"limit":8}`), "")
+		require.Equal(t, http.StatusOK, run.Code, run.Body.String())
+		var result MailboxDiscoveryRunResponse
+		require.NoError(t, json.Unmarshal(run.Body.Bytes(), &result))
+		require.Empty(t, result.Error)
+		if pass == 0 {
+			require.Len(t, result.Results, 1)
+			assert.Equal(t, "shared", result.Results[0].Status)
+			assert.Equal(t, 1, result.ProviderRequests)
+		} else {
+			assert.Zero(t, result.ProviderRequests)
+		}
+	}
+	assert.Equal(t, int32(1), calls.Load())
+	profile, err := st.GetPersonProfileContext(t.Context(), person.ID)
+	require.NoError(t, err)
+	assert.Equal(t, []int64{known}, profile.Person.ParticipantIDs)
+	history := personRequest(t, srv, http.MethodGet, "/api/v1/identity/discovery/history", nil, "")
+	require.Equal(t, http.StatusOK, history.Code)
+	assert.Contains(t, history.Body.String(), `"status":"shared"`)
+	assert.NotContains(t, history.Body.String(), "own_signature")
+	revoke := personRequest(t, srv, http.MethodPost, "/api/v1/identity/discovery/revoke", []byte(`{"disclosure_fingerprint":"`+fp+`"}`), "")
+	require.Equal(t, http.StatusOK, revoke.Code)
+	run = personRequest(t, srv, http.MethodPost, "/api/v1/identity/discovery/run", []byte(`{"limit":8}`), "")
+	assert.Equal(t, http.StatusConflict, run.Code)
+	assert.Equal(t, int32(1), calls.Load())
+}
