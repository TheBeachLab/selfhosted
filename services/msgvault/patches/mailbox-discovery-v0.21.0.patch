+func TestMailboxDiscoveryPublishesExtractionWithoutBindingAndCaches(t *testing.T) {
+	f, sender, _ := mailboxFixture(t)
+	page, err := f.store.DiscoverMailboxCandidatesContext(t.Context(), 5000)
+	require.NoError(t, err)
+	require.Len(t, page.Candidates, 1)
+	c := page.Candidates[0]
+	assert.NotContains(t, c.Packet.Candidate.Text, "Confidential")
+	assert.NotContains(t, c.Packet.Candidate.Text, "Quoted")
+	fp, token, err := f.store.ClaimMailboxDiscoveryContext(t.Context(), c, mailboxConsent(t, f.store))
+	require.NoError(t, err)
+	require.NotEmpty(t, token)
+	j := mailboxdiscovery.Judgment{Related: 0.68, Shared: 0.97}
+	r, err := f.store.FinishMailboxDiscoveryContext(t.Context(), c, fp, token, &j)
+	require.NoError(t, err)
