+	profile, err := f.store.GetPersonProfileContext(t.Context(), f.alicePersonID)
+	require.NoError(t, err)
+	assert.Equal(t, []int64{f.aliceID}, profile.Person.ParticipantIDs)
+	var found bool
+	for _, point := range profile.ContactPoints {
+		if point.OriginalValue == "household@example.test" {
+			found = true
+			require.NotNil(t, point.Envelope.TypeLabel)
+			assert.Equal(t, "posiblemente compartido", *point.Envelope.TypeLabel)
+			assert.Equal(t, store.ProvenanceExtraction, point.Envelope.Source)
+			assert.Equal(t, 0.68, *point.Envelope.Confidence)
+			assert.Nil(t, point.Envelope.Pref)
+			assert.Equal(t, "mailbox-discovery:"+fp, *point.Envelope.SourceRef)
+		}
+	}
+	assert.True(t, found)
+	var bound int
+	require.NoError(t, f.store.DB().QueryRow(`SELECT COUNT(*) FROM person_participants WHERE participant_id=?`, sender).Scan(&bound))
+	assert.Zero(t, bound)
+	_, token, err = f.store.ClaimMailboxDiscoveryContext(t.Context(), c, mailboxConsent(t, f.store))
+	require.NoError(t, err)
+	assert.Empty(t, token)
+	history, err := f.store.ListMailboxDiscoveryHistoryContext(t.Context())
+	require.NoError(t, err)
+	require.Len(t, history, 1)
+	assert.Equal(t, 0.97, history[0].Judgment.Shared)
+}
