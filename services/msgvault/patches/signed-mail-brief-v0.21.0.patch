@@ -0,0 +1,22 @@
+package mailboxdiscovery
+
+import (
+	"github.com/stretchr/testify/assert"
+	"testing"
+)
+
+func TestSigningPersonUsesOwnSignOffBeforeSharedFooter(t *testing.T) {
+	for _, tt := range []struct{ name, text, want string }{
+		{"sole", "Hallo,\nText\nViele Grüße\nAlice Example\n\n*Alice Example & Bob Example*\n*Telefon 123456789*", "person"},
+		{"short", "Text\nBis morgen, VG, Alice", "person"},
+		{"joint", "Text\nViele Grüße\nAlice & Bob", "joint"},
+		{"joint full", "Text\nRegards,\nAlice Example & Bob Example\nMobil: 12345678", "joint"},
+		{"other", "Text\nRegards,\nBob Example\n\nAlice Example & Bob Example\nMobil: 12345678", ""},
+		{"footer only", "Text\n\nAlice Example & Bob Example\nMobil: 12345678", ""},
+		{"quoted GMX", "VG, Bob\n*Gesendet:* Montag\n*Von:* Alice\nRegards,\nAlice Example", ""},
+		{"mention", "Alice Example liked the idea.\nThanks", ""},
+		{"unsigned", "super, bis morgen!", ""},
+	} {
+		t.Run(tt.name, func(t *testing.T) { assert.Equal(t, tt.want, SigningPerson(tt.text, "Alice Example")) })
+	}
+}
