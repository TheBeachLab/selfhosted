new file mode 100644
index 0000000..3c2cb3f
--- /dev/null
+++ b/internal/store/person_signed_mail_test.go
@@ -0,0 +1,76 @@
+package store_test
+
+import (
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.kenn.io/msgvault/internal/mailboxdiscovery"
+	"go.kenn.io/msgvault/internal/peoplesweep"
+	"go.kenn.io/msgvault/internal/personfacts"
+	"go.kenn.io/msgvault/internal/store"
+	"testing"
+)
+
+func TestSignedMailboxBriefScopeUpdatesWithoutBindingOrExtraction(t *testing.T) {
+	t.Setenv("MSGVAULT_PEOPLE_EMAIL_DISCOVERY", "1")
+	t.Setenv("MSGVAULT_PEOPLE_EMAIL_EVIDENCE", "1")
+	f, sender, message := mailboxFixture(t)
+	_, err := f.store.SetPersonBriefEnrollmentContext(t.Context(), f.alicePersonID, true, "fixture", false)
+	require.NoError(t, err)
+	page, err := f.store.DiscoverMailboxCandidatesContext(t.Context(), 5000)
+	require.NoError(t, err)
+	require.Len(t, page.Candidates, 1)
+	disclosure := mailboxConsent(t, f.store)
+	fp, token, err := f.store.ClaimMailboxDiscoveryContext(t.Context(), page.Candidates[0], disclosure)
+	require.NoError(t, err)
+	_, err = f.store.FinishMailboxDiscoveryContext(t.Context(), page.Candidates[0], fp, token, &mailboxdiscovery.Judgment{Related: .76, Shared: .91})
+	require.NoError(t, err)
+	count, err := f.store.RefreshSignedMailboxEvidenceContext(t.Context())
+	require.NoError(t, err)
+	assert.Equal(t, 1, count)
+	count, err = f.store.RefreshSignedMailboxEvidenceContext(t.Context())
+	require.NoError(t, err)
+	assert.Zero(t, count)
+	_, err = f.store.HydratePersonSweepMessages(t.Context(), f.alicePersonID, []int64{message}, 0)
+	require.Error(t, err, "extraction must retain sender-bound scope")
+	ctx := peoplesweep.BriefEvidenceContext(t.Context())
+	items, err := f.store.HydratePersonSweepMessages(ctx, f.alicePersonID, []int64{message}, 0)
+	require.NoError(t, err)
+	require.Len(t, items, 1)
+	assert.Equal(t, "person", items[0].MessageAuthorship)
+	assert.Equal(t, personfacts.DirectSelf, items[0].Directness)
+	assert.NotContains(t, items[0].Excerpt, "Quoted unrelated")
+	ids, err := f.store.ListPersonSweepHistoricalCandidates(ctx, peoplesweep.HistoricalCandidateRequest{PersonID: f.alicePersonID, SourceClasses: []peoplesweep.SourceClass{peoplesweep.SourceConversationText}, Limit: 40, AuthoredByPerson: true})
+	require.NoError(t, err)
+	assert.Contains(t, ids, message)
+	profile, err := f.store.GetPersonContext(t.Context(), f.alicePersonID)
+	require.NoError(t, err)
+	assert.Equal(t, []int64{f.aliceID}, profile.ParticipantIDs)
+	assert.NotContains(t, profile.ParticipantIDs, sender)
+	_, err = f.store.DB().Exec(`UPDATE message_bodies SET body_text=? WHERE message_id=?`, "Text\nRegards,\nAlice & Bob", message)
+	require.NoError(t, err)
+	_, err = f.store.HydratePersonSweepMessages(ctx, f.alicePersonID, []int64{message}, 0)
+	require.Error(t, err, "an edit fails closed before the next index pass")
+	count, err = f.store.RefreshSignedMailboxEvidenceContext(t.Context())
+	require.NoError(t, err)
+	assert.Equal(t, 1, count)
+	items, err = f.store.HydratePersonSweepMessages(ctx, f.alicePersonID, []int64{message}, 0)
+	require.NoError(t, err)
+	require.Len(t, items, 1)
+	assert.Equal(t, "joint", items[0].MessageAuthorship)
+	assert.Equal(t, personfacts.DirectOther, items[0].Directness)
+	item := items[0]
+	ref, err := peoplesweep.EncodePersonSweepEvidenceRef(item.Ref)
+	require.NoError(t, err)
+	start, end := int64(item.Highlight.Start), int64(item.Highlight.End)
+	aligned, err := (store.PersonSweepEvidenceAligner{Store: f.store}).Align(t.Context(), personfacts.EvidenceInput{PersonID: item.PersonID, SourceClass: personfacts.EvidenceArchive, Directness: item.Directness, Authority: item.Authority, SourceRef: ref, SubjectPersonID: item.SubjectPersonID, SpanStart: &start, SpanEnd: &end, Excerpt: item.Excerpt, ContentSHA256: item.ContentSHA256, SourceVersion: item.SourceVersion, EventTime: item.EventTime, RecordedTime: item.RecordedTime, IdentityScore: item.IdentityBasisPoints})
+	require.NoError(t, err)
+	assert.Nil(t, aligned.Failure, "brief citations align through the same native committer")
+
+	_, err = f.store.RevokePersonMatchConsentContext(t.Context(), disclosure, "fixture", nil)
+	require.NoError(t, err)
+	_, err = f.store.HydratePersonSweepMessages(ctx, f.alicePersonID, []int64{message}, 0)
+	require.Error(t, err)
+	count, err = f.store.RefreshSignedMailboxEvidenceContext(t.Context())
+	require.NoError(t, err)
+	assert.Equal(t, 1, count)
+}
