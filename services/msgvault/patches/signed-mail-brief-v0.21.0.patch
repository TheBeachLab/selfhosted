+package peoplesweep
+
+import "context"
+
+type briefEvidenceContextKey struct{}
+
+// BriefEvidenceContext admits locally verified per-message signing evidence
+// from a related mailbox. Extraction retains the original sender-bound scope.
+func BriefEvidenceContext(ctx context.Context) context.Context {
+	return context.WithValue(ctx, briefEvidenceContextKey{}, true)
+}
+
+func IsBriefEvidenceContext(ctx context.Context) bool {
+	value, _ := ctx.Value(briefEvidenceContextKey{}).(bool)
+	return value
+}
