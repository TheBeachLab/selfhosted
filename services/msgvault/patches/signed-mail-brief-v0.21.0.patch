diff --git a/internal/store/person_signed_mail.go b/internal/store/person_signed_mail.go
new file mode 100644
index 0000000..84fbfa6
--- /dev/null
+++ b/internal/store/person_signed_mail.go
@@ -0,0 +1,311 @@
+package store
+
+import (
+	"context"
+	"database/sql"
+	"errors"
+	"fmt"
+	"os"
+	"slices"
+	"strings"
+
+	"go.kenn.io/msgvault/internal/mailboxdiscovery"
+	"go.kenn.io/msgvault/internal/peoplesweep"
+)
+
+// Every read checks the active, derived contact and the exact consented Jev
+// judgment. A revoked consent or changed/curated contact stops admission.
+const signedContactSQL = ` FROM person_contact_points cp
+ JOIN mailbox_discovery_judgments j ON j.contact_point_id=cp.id
+ WHERE cp.person_id=? AND cp.source='extraction'
+ AND cp.source_ref='mailbox-discovery:' || j.fingerprint
+ AND cp.address_kind='email' AND cp.active_until IS NULL AND cp.superseded_at IS NULL
+ AND j.status IN ('related','shared')
+ AND EXISTS (SELECT 1 FROM person_match_consents pc WHERE pc.disclosure_fingerprint=j.disclosure AND pc.revoked_at IS NULL)
+ AND EXISTS (SELECT 1 FROM person_tracking pt WHERE pt.person_id=cp.person_id)
+ AND EXISTS (SELECT 1 FROM person_brief_enrollments be WHERE be.person_id=cp.person_id)`
+
+func signedMailEnabled() bool {
+	return os.Getenv("MSGVAULT_PEOPLE_EMAIL_DISCOVERY") == "1" && personSweepEmailEvidenceEnabled("imap")
+}
+
+func signedMailPredicate(ctx context.Context, person int64) (string, []any) {
+	if !signedMailEnabled() || !peoplesweep.IsBriefEvidenceContext(ctx) {
+		return "", nil
+	}
+	return ` OR EXISTS (SELECT 1 FROM person_signed_mail_evidence se
+	 WHERE se.person_id=? AND se.message_id=m.id AND se.sender_id=m.sender_id
+	 AND EXISTS (SELECT 1 ` + signedContactSQL + ` AND cp.id=se.contact_point_id))`, []any{person, person}
+}
+
+// signedMailAuthorship validates the current message again at hydration and
+// alignment. The index is a candidate list, never authority for edited text.
+func (s *Store) signedMailAuthorship(ctx context.Context, person, message int64, body string) (string, int64, error) {
+	if !signedMailEnabled() || !peoplesweep.IsBriefEvidenceContext(ctx) {
+		return "", 0, nil
+	}
+	var hash, kind string
+	var sender int64
+	err := s.db.QueryRowContext(ctx, s.Rebind(`SELECT se.body_sha256,se.authorship,se.sender_id
+	 FROM person_signed_mail_evidence se JOIN messages m ON m.id=se.message_id
+	 WHERE se.person_id=? AND se.message_id=? AND se.sender_id=m.sender_id
+	 AND (m.is_from_me=FALSE OR m.is_from_me IS NULL)
+	 AND (m.is_forwarded=FALSE OR m.is_forwarded IS NULL)
+	 AND EXISTS (SELECT 1 `+signedContactSQL+` AND cp.id=se.contact_point_id)`), person, message, person).Scan(&hash, &kind, &sender)
+	if errors.Is(err, sql.ErrNoRows) {
+		return "", 0, nil
+	}
+	if err != nil {
+		return "", 0, fmt.Errorf("signed mail hydration: %w", err)
+	}
+	p, err := s.GetPersonContext(ctx, person)
+	if err != nil {
+		return "", 0, err
+	}
+	if p.DisplayName == nil || hash != sweepSHA256(truncateSweepRunes(body, 32768)) ||
+		kind != mailboxdiscovery.SigningPerson(personSweepEmailOwnText(body), *p.DisplayName) {
+		return "", 0, nil
+	}
+	return kind, sender, nil
+}
+
+type signedMailRow struct {
+	person, message, sender, point, source int64
+	hash, kind                             string
+}
+
+// RefreshSignedMailboxEvidenceContext runs locally after mailbox discovery.
+// Only coordinates and hashes are stored; no mail is rewritten. Changed rows
+// publish normal journal work, which only the brief context may hydrate.
+func (s *Store) RefreshSignedMailboxEvidenceContext(ctx context.Context) (int, error) {
+	if !signedMailEnabled() {
+		return 0, nil
+	}
+	people, err := s.ListTrackedPeopleContext(ctx, 0, 1000)
+	if err != nil {
+		return 0, err
+	}
+	next := map[[2]int64]signedMailRow{}
+	for _, person := range people {
+		p, err := s.GetPersonContext(ctx, person)
+		if err != nil {
+			return 0, err
+		}
+		if p.DisplayName == nil {
+			continue
+		}
+		rows, err := s.db.QueryContext(ctx, s.Rebind(`SELECT cp.id,j.sender_id,cp.normalized_value`+signedContactSQL), person)
+		if err != nil {
+			return 0, err
+		}
+		type contact struct {
+			point, sender int64
+			email         string
+		}
+		contacts := []contact{}
+		for rows.Next() {
+			var c contact
+			if err := rows.Scan(&c.point, &c.sender, &c.email); err != nil {
+				_ = rows.Close()
+				return 0, err
+			}
+			contacts = append(contacts, c)
+		}
+		err = rows.Err()
+		_ = rows.Close()
+		if err != nil {
+			return 0, err
+		}
+		for _, c := range contacts {
+			messages, err := s.mailboxMessages(ctx, c.sender, 0, 2000)
+			if err != nil {
+				return 0, err
+			}
+			for _, m := range messages {
+				if strings.ToLower(strings.TrimSpace(m.email)) != strings.ToLower(c.email) || slices.Contains(p.ParticipantIDs, m.sender) {
+					continue
+				}
+				var body sql.NullString
+				err = s.db.QueryRowContext(ctx, s.Rebind(`SELECT SUBSTR(body_text,1,32768) FROM message_bodies WHERE message_id=?`), m.id).Scan(&body)
+				if errors.Is(err, sql.ErrNoRows) {
+					continue
+				}
+				if err != nil {
+					return 0, err
+				}
+				kind := mailboxdiscovery.SigningPerson(personSweepEmailOwnText(body.String), *p.DisplayName)
+				if kind == "" {
+					continue
+				}
+				var source int64
+				if err = s.db.QueryRowContext(ctx, s.Rebind(`SELECT source_id FROM messages WHERE id=?`), m.id).Scan(&source); err != nil {
+					return 0, err
+				}
+				next[[2]int64{person, m.id}] = signedMailRow{person: person, message: m.id, sender: m.sender, point: c.point, source: source, hash: sweepSHA256(body.String), kind: kind}
+			}
+		}
+	}
+	changed := 0
+	err = s.withTxContext(ctx, func(tx *loggedTx) error {
+		rows, err := tx.QueryContext(ctx, `SELECT person_id,message_id,sender_id,contact_point_id,source_id,body_sha256,authorship FROM person_signed_mail_evidence ORDER BY person_id,message_id`)
+		if err != nil {
+			return err
+		}
+		old := map[[2]int64]signedMailRow{}
+		for rows.Next() {
+			var r signedMailRow
+			if err := rows.Scan(&r.person, &r.message, &r.sender, &r.point, &r.source, &r.hash, &r.kind); err != nil {
+				_ = rows.Close()
+				return err
+			}
+			old[[2]int64{r.person, r.message}] = r
+		}
+		err = rows.Err()
+		_ = rows.Close()
+		if err != nil {
+			return err
+		}
+		keys := make([][2]int64, 0, len(next)+len(old))
+		for key := range next {
+			keys = append(keys, key)
+		}
+		for key := range old {
+			if _, ok := next[key]; !ok {
+				keys = append(keys, key)
+			}
+		}
+		slices.SortFunc(keys, func(a, b [2]int64) int {
+			if a[0] < b[0] || a[0] == b[0] && a[1] < b[1] {
+				return -1
+			}
+			if a == b {
+				return 0
+			}
+			return 1
+		})
+		dirty := []int64{}
+		for _, key := range keys {
+			r, exists := next[key]
+			before, had := old[key]
+			if exists && had && r == before {
+				continue
+			}
+			changed++
+			if exists {
+				_, err = tx.ExecContext(ctx, s.Rebind(`INSERT INTO person_signed_mail_evidence (person_id,message_id,sender_id,contact_point_id,source_id,body_sha256,authorship) VALUES (?,?,?,?,?,?,?) ON CONFLICT(person_id,message_id) DO UPDATE SET sender_id=excluded.sender_id,contact_point_id=excluded.contact_point_id,source_id=excluded.source_id,body_sha256=excluded.body_sha256,authorship=excluded.authorship`), r.person, r.message, r.sender, r.point, r.source, r.hash, r.kind)
+			} else {
+				r = before
+				_, err = tx.ExecContext(ctx, s.Rebind(`DELETE FROM person_signed_mail_evidence WHERE person_id=? AND message_id=?`), r.person, r.message)
+			}
+			if err != nil {
+				return err
+			}
+			_, err = tx.ExecContext(ctx, s.Rebind(`INSERT INTO person_signed_mail_watch(person_id) VALUES (?) ON CONFLICT DO NOTHING`), r.person)
+			if err != nil {
+				return err
+			}
+			change := peoplesweep.ArchiveChange{PersonID: r.person, SourceLane: peoplesweep.SourceConversationText, Kind: peoplesweep.ChangeUpsert, SourceID: r.source, MessageID: r.message}
+			if had {
+				change.EvidenceEffect = peoplesweep.EvidenceEffectSourceEdited
+			}
+			if !exists {
+				change.Kind = peoplesweep.ChangeScope
+				change.EvidenceEffect = peoplesweep.EvidenceEffectScopeUnlinked
+			}
+			if err = s.appendPersonSweepChangeTx(ctx, tx, change); err != nil {
+				return err
+			}
+			dirty = append(dirty, r.person)
+		}
+		// A message can be hard-deleted with a cascading index removal.
+		// Retain the person's membership digest so that removal still wakes
+		// the brief even though its unbound sender has no person journal edge.
+		watchers, err := tx.QueryContext(ctx, `SELECT person_id,snapshot_sha256 FROM person_signed_mail_watch ORDER BY person_id`)
+		if err != nil {
+			return err
+		}
+		previous := map[int64]string{}
+		for watchers.Next() {
+			var id int64
+			var hash string
+			if err := watchers.Scan(&id, &hash); err != nil {
+				_ = watchers.Close()
+				return err
+			}
+			previous[id] = hash
+		}
+		err = watchers.Err()
+		_ = watchers.Close()
+		if err != nil {
+			return err
+		}
+		for id, oldHash := range previous {
+			var input strings.Builder
+			for _, key := range keys {
+				if r, ok := next[key]; ok && r.person == id {
+					fmt.Fprintf(&input, "%d:%d:%s:%s;", r.message, r.point, r.hash, r.kind)
+				}
+			}
+			hash := sweepSHA256(input.String())
+			if hash == oldHash {
+				continue
+			}
+			_, err = tx.ExecContext(ctx, s.Rebind(`UPDATE person_signed_mail_watch SET snapshot_sha256=? WHERE person_id=?`), hash, id)
+			if err != nil {
+				return err
+			}
+			if !slices.Contains(dirty, id) {
+				changed++
+				if err = s.appendPersonSweepChangeTx(ctx, tx, peoplesweep.ArchiveChange{PersonID: id, SourceLane: peoplesweep.SourceConversationText, Kind: peoplesweep.ChangeScope}); err != nil {
+					return err
+				}
+				dirty = append(dirty, id)
+			}
+		}
+		return s.coalescePersonSweepPeopleTx(ctx, tx, dirty)
+	})
+	return changed, err
+}
+
+func (s *Store) PendingSignedMailboxBriefPeopleContext(ctx context.Context) ([]int64, error) {
+	rows, err := s.db.QueryContext(ctx, `SELECT w.person_id FROM person_signed_mail_watch w WHERE EXISTS (SELECT 1 FROM person_tracking pt WHERE pt.person_id=w.person_id) AND EXISTS (SELECT 1 FROM person_brief_enrollments e WHERE e.person_id=w.person_id) ORDER BY w.person_id LIMIT 1000`)
+	if err != nil {
+		return nil, err
+	}
+	ids := []int64{}
+	for rows.Next() {
+		var id int64
+		if err = rows.Scan(&id); err != nil {
+			_ = rows.Close()
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	err = rows.Err()
+	_ = rows.Close()
+	if err != nil {
+		return nil, err
+	}
+	pending := []int64{}
+	for _, id := range ids {
+		e, ok, err := s.PersonSweepBriefEligibility(ctx, id)
+		if err != nil {
+			return nil, err
+		}
+		if !ok {
+			continue
+		}
+		seq := int64(0)
+		if e.Boundary != nil {
+			seq = e.Boundary.ThroughSequence
+		}
+		dirty, err := s.HasPersonSweepChangesAfter(ctx, id, seq)
+		if err != nil {
+			return nil, err
+		}
+		if dirty {
+			pending = append(pending, id)
+		}
+	}
+	return pending, nil
+}
