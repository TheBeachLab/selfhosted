new file mode 100644
index 0000000..1d0e9b7
--- /dev/null
+++ b/internal/mailboxdiscovery/signing.go
@@ -0,0 +1,66 @@
+package mailboxdiscovery
+
+import (
+	"regexp"
+	"strings"
+)
+
+// OwnText excludes rich-text GMX reply headers as well as the caller's plain
+// quote stripping. Use the same text for signing and brief evidence.
+func OwnText(text string) string {
+	if loc := decoratedReplyHeader.FindStringIndex(text); loc != nil {
+		text = text[:loc[0]]
+	}
+	return strings.TrimSpace(text)
+}
+
+var closingLine = regexp.MustCompile(`(?i)(?:grü[ßs]e|gruss|gruß|regards|best wishes|sincerely|saludos|cordialement|bis (?:morgen|bald)|\bvg\b)`)
+
+// SigningPerson requires a personal sign-off, not a name mentioned in prose or
+// a shared contact footer. First names are allowed only at an explicit closing.
+// The mailbox relation itself must already have a consented Jev judgment.
+// "joint" describes the authorship of this message, never the whole mailbox.
+func SigningPerson(text, name string) string {
+	text = OwnText(text)
+	full := normalizeName(name)
+	parts := strings.Fields(full)
+	if len(parts) < 2 {
+		return ""
+	}
+	lines := strings.Split(text, "\n")
+	for i := len(lines) - 1; i >= max(0, len(lines)-28); i-- {
+		line := strings.TrimSpace(lines[i])
+		if !closingLine.MatchString(line) {
+			continue
+		}
+		candidate := line
+		closing := closingLine.MatchString(line)
+		if closing {
+			if p := strings.LastIndex(line, ","); p >= 0 {
+				candidate = strings.TrimSpace(line[p+1:])
+			}
+			if (strings.TrimSpace(candidate) == "" || closingLine.MatchString(candidate)) && i+1 < len(lines) {
+				for next := i + 1; next < min(len(lines), i+4); next++ {
+					candidate = strings.TrimSpace(lines[next])
+					if candidate != "" {
+						break
+					}
+				}
+			}
+		}
+		n := normalizeName(candidate)
+		// The closing must lead directly to named signers. A combined
+		// contact footer on its own never qualifies.
+		joint := strings.Contains(candidate, "&") || strings.Contains(candidate, " und ") || strings.Contains(candidate, " and ") || strings.Contains(candidate, " y ")
+		if n == full || (closing && n == parts[0]) {
+			return "person"
+		}
+		if closing && joint && (strings.HasPrefix(n, full+" ") || strings.HasPrefix(n, parts[0]+" ")) {
+			return "joint"
+		}
+		if closing && n != "" && !closingLine.MatchString(candidate) {
+			return "" // A different named signer wins over a shared footer.
+		}
+	}
+	return ""
+}
