diff --git a/cmd/msgvault/cmd/serve_signed_mail.go b/cmd/msgvault/cmd/serve_signed_mail.go
new file mode 100644
index 0000000..24446dc
--- /dev/null
+++ b/cmd/msgvault/cmd/serve_signed_mail.go
@@ -0,0 +1,56 @@
+package cmd
+
+import (
+	"context"
+	"errors"
+	"time"
+
+	"go.kenn.io/msgvault/internal/api"
+	"go.kenn.io/msgvault/internal/config"
+	"go.kenn.io/msgvault/internal/peoplesweep"
+	"go.kenn.io/msgvault/internal/store"
+)
+
+// The existing NUC timer wakes discovery; the daemon then indexes explicit
+// own sign-offs and runs its normal consented/budgeted worker for dirty briefs.
+// Unchanged mail causes no provider call. No profile prose enters this adapter.
+func newSignedMailboxBriefRefresh(cfg *config.Config, st *store.Store, gate api.OperationGate) func(context.Context) (int, int, error) {
+	return func(ctx context.Context) (int, int, error) {
+		if gate != nil {
+			done, ok := gate.BeginWorkContext(ctx)
+			if !ok {
+				return 0, 0, errors.New("signed mail archive busy")
+			}
+			defer done()
+		}
+		changed, err := st.RefreshSignedMailboxEvidenceContext(ctx)
+		if err != nil {
+			return changed, 0, err
+		}
+		ids, err := st.PendingSignedMailboxBriefPeopleContext(ctx)
+		if err != nil || len(ids) == 0 {
+			return changed, 0, err
+		}
+		worker, err := newProductionPersonSweepWorker(cfg, st)
+		if err != nil {
+			return changed, 0, err
+		}
+		// This scope is explicitly watched for new signed mail. Other people's
+		// brief cadence retains the configured minimum. New activity, enrollment,
+		// provider consent, leases and all spending caps still apply.
+		worker.Config.Brief.MinInterval = time.Minute
+		generated := 0
+		for _, id := range ids {
+			result, err := worker.Run(ctx, peoplesweep.RunRequest{Kind: peoplesweep.RunScheduled, Mode: peoplesweep.RunIncremental, PersonID: id, Limit: 1, Brief: peoplesweep.BriefModeAuto})
+			if err != nil {
+				return changed, generated, err
+			}
+			for _, p := range result.People {
+				if p.BriefVersion > 0 {
+					generated++
+				}
+			}
+		}
+		return changed, generated, nil
+	}
+}
