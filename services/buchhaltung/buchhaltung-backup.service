[Unit]
Description=Verified encrypted Buchhaltung backup to Synology
After=network-online.target
Wants=network-online.target
OnFailure=service-failure-notify@%n.service

[Service]
Type=oneshot
User=buchhaltung
Group=buchhaltung
EnvironmentFile=/etc/buchhaltung/private.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/buchhaltung/venv/bin/python /opt/buchhaltung/current/backup.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/buchhaltung /mnt/nas-downloads/backups/buchhaltung-encrypted
MemoryMax=512M
CPUQuota=100%
TasksMax=32
TimeoutStartSec=15min
