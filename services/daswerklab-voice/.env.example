PUBLIC_BASE_URL=https://daswerklab.de/voice
TWILIO_ACCOUNT_SID=
# Token from the active call region: Ireland (IE1).
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+498951042000
FRAN_PHONE_NUMBER=+491715820901
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
# Use elevenlabs only after its key, voice and streaming access are checked.
VOICE_PROVIDER=openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=cllvQaMvj0ZKxH88HGEn
ELEVENLABS_MODEL=eleven_v4_turbo
# Less sensitive to background noise; keep normal spoken interruption enabled.
VAD_THRESHOLD=0.8
INPUT_NOISE_REDUCTION=near_field
STATE_DIR=/var/lib/daswerklab-voice
MAX_CALL_SECONDS=600
MAX_CONCURRENT_CALLS=4
# Comma-separated E.164 caller numbers that should ring Fran immediately.
# Leave empty during testing so Fran can call the agent from his mobile.
DIRECT_CALLERS=
