[Unit]
Description=Manual Minecraft world backup to the verified USB drive
After=mnt-minecraft\x2dbackups.automount
Wants=mnt-minecraft\x2dbackups.automount

[Service]
Type=oneshot
ExecStart=/usr/bin/flock /run/beachlab-admin-control.lock /usr/local/sbin/mc-usb-backup --manual
StateDirectory=minecraft-usb-backup
StateDirectoryMode=0700
TimeoutStartSec=infinity
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
